# Copy to .env.local and adjust. Everything in VITE_* ships to the browser: never put secrets here.
VITE_API_BASE_URL=http://localhost:3001
# Public OAuth client ID. Must be the same client as the backend's GOOGLE_CLIENT_ID. Never put the client secret here.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
